# ----------------------------------------------------------------------------
# Backend Environment Variables
# Copy this file to ".env" and adjust the values for your environment.
# ----------------------------------------------------------------------------

# PostgreSQL connection string used by the pg pool.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventory_db"

# Port the Express server listens on.
PORT=8000

# Node environment (development | production).
NODE_ENV=development

# Secret used to sign JWT tokens. Use a long, random string in production.
JWT_SECRET="super-secret-change-me-in-production"

# How long an issued JWT remains valid.
JWT_EXPIRES_IN="7d"

# Comma-separated list of origins allowed by CORS.
CORS_ORIGIN="http://localhost:5173"
